---
import figlet from 'figlet';

const banner = figlet.textSync('LAURA', { font: 'ANSI Shadow' }).replace(/\s+$/gm, '');
const aliasBanner = figlet.textSync('LANTHANUM89', { font: 'ANSI Shadow' }).replace(/\s+$/gm, '');

// Get this by connecting your account at https://spotify-github-profile.kittinanx.com/api/login
const SPOTIFY_UID = 'riotgrrrl5';

const spotifyBadgeUrl = SPOTIFY_UID
  ? `https://spotify-github-profile.kittinanx.com/api/view?uid=${SPOTIFY_UID}&cover_image=false&theme=compact&show_offline=true&background_color=14171d&bar_color=f2789f&interchange=false`
  : null;
---

<footer class="footer">
  <div class="wrapper">
    <div class="footer__top">
      <div class="footer__banner-block">
        <div class="footer__banner-scroll footer__banner-scroll--first">
          <pre class="footer__banner" aria-hidden="true">{banner}</pre>
        </div>
        <p class="footer__banner-label mono">// aka</p>
        <div class="footer__banner-scroll footer__banner-scroll--alias">
          <pre class="footer__banner footer__banner--alias" aria-hidden="true">{aliasBanner}</pre>
        </div>
        <p class="footer__banner-alias-text mono" aria-hidden="true">LANTHANUM89</p>
      </div>

      {spotifyBadgeUrl && (
        <div class="footer__now-playing">
          <span class="footer__now-playing-label mono">// listening now</span>
          <img
            class="footer__now-playing-badge"
            src={spotifyBadgeUrl}
            alt="Laura's current Spotify listening activity"
            loading="lazy"
          />
        </div>
      )}
    </div>

    <div class="footer__inner">
      <p class="mono">
        <span class="prompt">laura@portfolio:~$</span> echo "thanks for stopping by"
      </p>

      <a href="https://github.com/Lanthanum89" target="_blank" rel="noreferrer" class="mono">github.com/Lanthanum89</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-top: 2rem;
  }

  .footer__banner-block {
    min-width: 0;
    flex: 1 1 20rem;
  }

  .footer__banner-scroll {
    overflow-x: auto;
  }

  .footer__banner {
    margin: 0;
    width: fit-content;
    color: var(--color-pink);
    opacity: 0.7;
    font-size: clamp(0.3rem, 1.4vw, 0.44rem);
    line-height: 1.3;
  }

  .footer__banner-label {
    margin: 0.6rem 0;
    color: var(--color-comment);
    font-size: 0.75rem;
  }

  .footer__banner--alias {
    color: var(--color-accent);
  }

  .footer__banner-alias-text {
    display: none;
    margin: 0;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 30rem) {
    .footer__banner-scroll--alias {
      display: none;
    }

    .footer__banner-alias-text {
      display: block;
    }
  }

  .footer__inner {
    padding-block: 1.5rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .prompt {
    color: var(--color-comment);
  }

  .footer__inner a {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .footer__inner a:hover {
    color: var(--color-accent-strong);
  }

  .footer__now-playing {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .footer__now-playing-label {
    color: var(--color-comment);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .footer__now-playing-badge {
    height: 4rem;
    width: auto;
    max-width: 22rem;
    object-fit: contain;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 30rem) {
    .footer__now-playing-badge {
      height: 3.25rem;
      max-width: 100%;
    }
  }
</style>
