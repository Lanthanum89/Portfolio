---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Position within its category after sorting recent-to-oldest; drives the preview cap. */
  rank?: number;
  /** Whether language/tool badges act as filter buttons. Off for the static Featured section. */
  filterable?: boolean;
}

const { project, rank, filterable = true } = Astro.props;
const Tag = filterable ? 'button' : 'span';
---

<article
  class="card"
  data-languages={project.languages.join('|')}
  data-tools={project.tools.join('|')}
  data-preview-rank={rank ?? undefined}
  data-reveal
>
  <div class="card__titlebar">
    <span class="dot dot--red"></span>
    <span class="dot dot--yellow"></span>
    <span class="dot dot--green"></span>
    <span class="card__filename mono">{project.slug}.{project.ext}</span>
    {project.story && (
      <button
        type="button"
        class="card__story-trigger mono"
        data-story-trigger
        data-story={JSON.stringify({
          name: project.name,
          description: project.description,
          url: project.url,
          ...project.story,
        })}
      >
        [build log]
      </button>
    )}
  </div>

  <div class="card__body">
    <a class="card__link" href={project.url} target="_blank" rel="noreferrer">
      <h3>
        {project.name}
        <span class="card__arrow" aria-hidden="true">↗</span>
      </h3>
      <p>{project.description}</p>
    </a>

    <div class="card__meta">
      {project.featured && <span class="badge badge--pinned mono">★ pinned</span>}
      {project.languages.map((language, index) => (
        <Tag
          type={filterable ? 'button' : undefined}
          class:list={['badge', 'mono', index === 0 ? 'badge--language' : 'badge--language-secondary']}
          data-filter-tag={filterable ? language : undefined}
        >
          {language}
        </Tag>
      ))}
      {project.tools.map((tool) => (
        <Tag type={filterable ? 'button' : undefined} class="badge mono" data-filter-tag={filterable ? tool : undefined}>
          {tool}
        </Tag>
      ))}
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    transform: translateY(-3px);
    box-shadow: 0 10px 28px -16px color-mix(in srgb, var(--color-pink) 45%, transparent);
  }

  :root[data-theme='light'] .card {
    border-color: transparent;
    box-shadow: 0 1px 2px rgba(30, 34, 44, 0.04), 0 6px 16px -10px rgba(30, 34, 44, 0.12);
  }

  :root[data-theme='light'] .card:hover {
    border-color: transparent;
    box-shadow: 0 10px 28px -14px color-mix(in srgb, var(--color-pink) 35%, transparent),
      0 1px 2px rgba(30, 34, 44, 0.04);
  }

  .card.is-hidden {
    display: none;
  }

  .card__titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
  }

  .card__story-trigger {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    background: transparent;
    color: var(--color-pink);
    border: 1px solid var(--color-pink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .card__story-trigger:hover {
    background: var(--color-pink);
    color: var(--color-on-accent);
  }

  .card__story-trigger:active {
    transform: scale(0.94);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot--red {
    background: var(--dot-red);
  }

  .dot--yellow {
    background: var(--dot-yellow);
  }

  .dot--green {
    background: var(--dot-green);
  }

  .card__filename {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card__link:hover h3 {
    color: var(--color-accent-strong);
  }

  .card__link:hover .card__arrow {
    transform: translate(3px, -3px);
    color: var(--color-pink);
  }

  .card h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .card__arrow {
    display: inline-block;
    margin-left: 0.15em;
    color: var(--color-text-muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .card p {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--color-bg-raised);
    color: var(--color-string);
    border: 1px solid var(--color-border);
    line-height: 1.4;
  }

  button.badge {
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  button.badge:hover {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  button.badge:active {
    transform: scale(0.94);
  }

  .badge--language {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  button.badge--language:hover {
    color: var(--color-on-accent);
    border-color: var(--color-pink);
    background: var(--color-pink);
  }

  .badge--language-secondary {
    color: var(--color-accent-strong);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
  }

  button.badge--language-secondary:hover {
    color: var(--color-pink);
    border-color: var(--color-pink);
    background: color-mix(in srgb, var(--color-pink) 12%, transparent);
  }

  .badge--pinned {
    color: var(--color-pink);
    background: color-mix(in srgb, var(--color-pink) 12%, transparent);
    border-color: var(--color-pink);
  }

</style>
