---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Position within its category after sorting recent-to-oldest; drives the preview cap. */
  rank?: number;
}

const { project, rank } = Astro.props;
---

<article
  class="card"
  data-language={project.language}
  data-preview-rank={rank ?? undefined}
  data-reveal
>
  <div class="card__titlebar">
    <span class="dot dot--red"></span>
    <span class="dot dot--yellow"></span>
    <span class="dot dot--green"></span>
    <span class="card__filename mono">{project.slug}.{project.ext}</span>
  </div>

  <div class="card__body">
    <h3><a href={project.url} target="_blank" rel="noreferrer">{project.name}</a></h3>
    <p>{project.description}</p>

    <div class="card__meta">
      {project.featured && <span class="badge badge--pinned mono">★ pinned</span>}
      <span class="badge badge--language mono">{project.language}</span>
      {project.tools.map((tool) => (
        <span class="badge mono">{tool}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    transform: translateY(-3px);
    box-shadow: 0 10px 28px -16px color-mix(in srgb, var(--color-pink) 45%, transparent);
  }

  .card.is-hidden {
    display: none;
  }

  .card__titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .dot--red {
    background: var(--dot-red);
  }

  .dot--yellow {
    background: var(--dot-yellow);
  }

  .dot--green {
    background: var(--dot-green);
  }

  .card__filename {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .card h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--color-accent-strong);
  }

  .card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--color-bg-raised);
    color: var(--color-string);
    border: 1px solid var(--color-border);
  }

  .badge--language {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .badge--pinned {
    color: var(--color-pink);
    background: color-mix(in srgb, var(--color-pink) 12%, transparent);
    border-color: var(--color-pink);
  }
</style>
