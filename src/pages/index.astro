---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, categoryOrder } from '../data/projects';
const featured = projects.filter((project) => project.featured);
const more = projects
  .filter((project) => !project.featured)
  .sort((a, b) => {
    if (Boolean(a.spotlight) !== Boolean(b.spotlight)) return a.spotlight ? -1 : 1;
    return new Date(b.pushedAt).getTime() - new Date(a.pushedAt).getTime();
  });
const languages = [...new Set(projects.flatMap((project) => project.languages))].sort();

// A project tagged with more than one category (e.g. an F1 ML model is both Sport and
// Data & ML) shows in every matching section.
const categories = categoryOrder
  .map((category) => ({
    name: category,
    items: more.filter((project) => project.categories.includes(category)),
  }))
  .filter((group) => group.items.length > 0);

const terminalFiles = projects.map((project) => `${project.slug}/`);

const slugifyCategory = (category: string): string =>
  category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const outlineLinks = [
  { href: '#about', label: 'about' },
  { href: '#projects', label: 'featured projects' },
  { href: '#all-projects', label: 'browse by tool' },
  { href: '#contact', label: 'contact' },
];
---

<Layout
  title="Laura Norwood | Developer"
  description="I build software that either solves a real problem or just makes someone smile."
>
  <Nav />

  <div class="page-outline" data-page-outline>
    <button
      type="button"
      class="page-outline__toggle"
      data-outline-toggle
      aria-expanded="false"
      aria-label="Show page outline"
    >
      <span aria-hidden="true">&#9776;</span>
    </button>
    <div class="page-outline__backdrop" data-outline-backdrop></div>
    <nav
      class="page-outline__drawer mono"
      aria-label="Page outline"
      inert
    >
      <div class="page-outline__drawer-head">
        <p class="page-outline__drawer-title">on this page</p>
        <button
          type="button"
          class="page-outline__close"
          data-outline-close
          aria-label="Close page outline"
        >
          &times;
        </button>
      </div>
      <ul class="page-outline__list" data-outline-list>
        {outlineLinks.map((link) => (
          <li><a href={link.href} data-outline-link>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <main id="top">
    <section class="hero">
      <div class="wrapper hero__inner">
      <p class="eyebrow mono hero-in" style="--hero-delay: 0ms">hi, i'm</p>
      <h1 class="mono hero-in" style="--hero-delay: 60ms">
        Laura Norwood<span class="cursor" aria-hidden="true"></span>
      </h1>
      <p class="hero__tagline hero-in" style="--hero-delay: 120ms">
        I build software that either solves a real problem or just makes someone smile.
      </p>
      <p class="hero__location mono hero-in" style="--hero-delay: 160ms">Based in Reading, England</p>
      <div class="hero__actions hero-in" style="--hero-delay: 200ms">
        <a class="button button--primary" href="#projects">View projects</a>
        <a class="button" href="https://github.com/Lanthanum89" target="_blank" rel="noreferrer">View GitHub</a>
      </div>

      <div
        class="terminal hero-in"
        style="--hero-delay: 260ms"
        data-terminal
        data-terminal-files={JSON.stringify(terminalFiles)}
      >
        <div class="terminal__titlebar">
          <span class="dot dot--red"></span>
          <span class="dot dot--yellow"></span>
          <span class="dot dot--green"></span>
          <span class="terminal__filename mono">laura@portfolio: ~</span>
        </div>
        <div class="terminal__output mono" data-terminal-output role="log" aria-live="polite">
          <p class="terminal__line">Type <code>help</code> to see what this does.</p>
        </div>
        <div class="terminal__input-row mono">
          <span class="terminal__prompt">laura@portfolio:~$</span>
          <input
            class="terminal__input"
            data-terminal-input
            type="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Terminal command input"
            placeholder="try 'help'"
          />
        </div>
      </div>
      </div>
    </section>

    <section id="about" class="wrapper section" data-reveal>
      <p class="eyebrow mono">about</p>
      <h2>What matters to me</h2>
      <div class="about-grid">
        <p>I care about two things in software: does it work, and is it actually nice to use.</p>
        <p>Professionally that's Power Platform apps, built with Node.js, TypeScript and React.</p>
        <p>Personally it's games, data tools, and whatever utility solves the problem in front of me.</p>
      </div>
    </section>

    <section class="wrapper section section--compact" data-reveal>
      <p class="eyebrow mono">tech i reach for</p>
      <div class="tech-row mono">
        {['Power Platform', 'TypeScript', 'JavaScript', 'React', 'Node.js', 'Python', 'SQL'].map((tech) => (
          <span class="tech-pill">{tech}</span>
        ))}
      </div>
    </section>

    <section id="projects" class="wrapper section" data-reveal>
      <p class="eyebrow mono">projects</p>
      <h2>Featured projects</h2>
      <p class="section__hint">A handful of projects I'm most proud of.</p>

      <div class="category-pills mono" role="group" aria-label="Jump to a project type">
        {categoryOrder.map((category) => (
          <a
            class="category-pill"
            href={`#category-${slugifyCategory(category)}`}
            data-category-jump={slugifyCategory(category)}
          >
            {category.toLowerCase()}
          </a>
        ))}
      </div>

      <div class="grid">
        {featured.map((project) => (
          <ProjectCard project={project} filterable={false} />
        ))}
      </div>
    </section>

    <section id="all-projects" class="wrapper section" data-projects-root>
      <p class="eyebrow mono">all projects</p>
      <h2>Browse by tool</h2>
      <p class="section__hint">
        Pick one or more languages or tools above, or click any badge on a card, to see the
        full, most-recent-first list matching any of them. Prefer to browse by type instead?
        Expand a category below.
      </p>

      <div class="filter-bar mono" data-filter-bar role="group" aria-label="Filter projects by language">
        <button type="button" data-filter="all" aria-pressed="true">all</button>
        {languages.map((language) => (
          <button type="button" data-filter={language} aria-pressed="false">{language.toLowerCase()}</button>
        ))}
      </div>

      <div class="active-filter mono" data-active-filter hidden></div>

      {categories.map((group) => (
        <div
          class="category-group"
          id={`category-${slugifyCategory(group.name)}`}
          data-category-group
          data-open="false"
        >
          <button
            type="button"
            class="category-toggle mono"
            data-group-toggle
            aria-expanded="false"
            aria-controls={`category-${slugifyCategory(group.name)}-body`}
          >
            <span class="category-toggle__marker" aria-hidden="true">&#9656;</span>
            // {group.name.toLowerCase()} <span class="category-toggle__count">({group.items.length})</span>
          </button>
          <div class="category-group__body" id={`category-${slugifyCategory(group.name)}-body`} data-group-body>
            <div class="category-heading-row">
              {group.items.length > 3 && (
                <button type="button" class="category-view-all mono" data-view-all>view all</button>
              )}
            </div>
            <div class="grid">
              {group.items.map((project, index) => (
                <ProjectCard project={project} rank={index} />
              ))}
            </div>
          </div>
        </div>
      ))}

      <p class="see-more">
        <a href="https://github.com/Lanthanum89?tab=repositories" target="_blank" rel="noreferrer">
          See everything on GitHub &rarr;
        </a>
      </p>
    </section>

    <section id="contact" class="wrapper section" data-reveal>
      <div class="contact-card">
        <p class="eyebrow mono">contact</p>
        <h2>Let's build something worth talking about.</h2>
        <p class="contact-card__hint">Open to hearing about interesting projects and opportunities.</p>
        <div class="contact-card__links">
          <a class="button" href="https://www.instagram.com/codermumuk/" target="_blank" rel="noreferrer">Instagram</a>
          <a class="button" href="https://www.linkedin.com/in/laura-norwood/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button" href="https://github.com/Lanthanum89" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <dialog id="story-modal" class="story-modal" aria-labelledby="story-modal-name">
    <div class="story-modal__titlebar">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
      <span class="story-modal__filename mono" data-story-filename></span>
      <button type="button" class="story-modal__close" data-story-close aria-label="Close">&times;</button>
    </div>
    <div class="story-modal__body">
      <p class="story-modal__eyebrow mono">// build log</p>
      <h2 id="story-modal-name" data-story-name></h2>
      <p class="story-modal__description" data-story-description></p>

      <section class="story-modal__section">
        <h3 class="mono">// the problem</h3>
        <p data-story-problem></p>
      </section>

      <section class="story-modal__section">
        <h3 class="mono">// how it evolved</h3>
        <ol class="story-modal__attempts" data-story-attempts></ol>
      </section>

      <section class="story-modal__section" data-story-challenge-section hidden>
        <h3 class="mono">// the technical challenge</h3>
        <p data-story-challenge></p>
      </section>

      <section class="story-modal__section" data-story-tradeoffs-section hidden>
        <h3 class="mono">// trade-offs</h3>
        <p data-story-tradeoffs></p>
      </section>

      <section class="story-modal__section" data-story-next-section hidden>
        <h3 class="mono">// what's next</h3>
        <p data-story-next></p>
      </section>

      <section class="story-modal__section" data-story-hindsight-section hidden>
        <h3 class="mono">// if i built it again</h3>
        <p data-story-hindsight></p>
      </section>

      <a class="story-modal__cta" data-story-cta target="_blank" rel="noreferrer">
        View the code <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </dialog>

  <Footer />

  <script>
    import { initProjectFilter } from '../scripts/project-filter';
    import { initThemeToggle } from '../scripts/theme-toggle';
    import { initScrollReveal } from '../scripts/scroll-reveal';
    import { initTerminal } from '../scripts/terminal';
    import { initStoryModal } from '../scripts/story-modal';
    import { initPageOutline } from '../scripts/page-outline';

    initProjectFilter();
    initThemeToggle();
    initScrollReveal();
    initTerminal();
    initStoryModal();
    initPageOutline();
  </script>
</Layout>

<style>
  .hero {
    padding-block: 6rem 3rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent) 16%, transparent) 0%,
      color-mix(in srgb, var(--color-pink) 14%, transparent) 55%,
      transparent 100%
    );
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 52rem;
    margin: 0 0 0.5rem;
  }

  .hero__location {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .terminal {
    margin-top: 2.5rem;
    max-width: 54rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
  }

  :root[data-theme='light'] .terminal {
    border-color: transparent;
    box-shadow: 0 1px 2px rgba(30, 34, 44, 0.05), 0 12px 32px -18px rgba(30, 34, 44, 0.22);
  }

  .terminal__titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal__titlebar .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal__titlebar .dot--red {
    background: var(--dot-red);
  }

  .terminal__titlebar .dot--yellow {
    background: var(--dot-yellow);
  }

  .terminal__titlebar .dot--green {
    background: var(--dot-green);
  }

  .terminal__filename {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .terminal__output {
    height: 8rem;
    overflow-y: auto;
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .terminal__output :global(.terminal__line) {
    margin: 0 0 0.25rem;
    color: var(--color-text-muted);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal__output :global(.terminal__line--echo) {
    color: var(--color-text);
    font-weight: 600;
  }

  .terminal__output :global(.terminal__line--echo)::before {
    content: none;
  }

  .terminal__input-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .terminal__prompt {
    color: var(--color-comment);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .terminal__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .terminal__input::placeholder {
    color: var(--color-text-muted);
  }

  .page-outline__toggle {
    position: fixed;
    top: 5.5rem;
    right: 1.5rem;
    z-index: 15;
    width: 2.2rem;
    height: 2.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  :root[data-theme='light'] .page-outline__toggle {
    box-shadow: 0 1px 2px rgba(30, 34, 44, 0.05), 0 8px 20px -14px rgba(30, 34, 44, 0.22);
  }

  .page-outline__toggle:hover,
  .page-outline__toggle[aria-expanded='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  @media (max-width: 60rem) {
    .page-outline__toggle {
      display: none;
    }
  }

  .page-outline__backdrop {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: color-mix(in srgb, black 45%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .page-outline.is-open .page-outline__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .page-outline__drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 21;
    width: min(20rem, 85vw);
    display: flex;
    flex-direction: column;
    background: var(--color-bg-alt);
    border-left: 1px solid var(--color-border);
    box-shadow: -12px 0 36px -18px rgba(0, 0, 0, 0.4);
    transform: translateX(100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
  }

  .page-outline.is-open .page-outline__drawer {
    transform: translateX(0);
  }

  .page-outline__drawer-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-outline__drawer-title {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .page-outline__close {
    flex-shrink: 0;
    width: 1.8rem;
    height: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    line-height: 1;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .page-outline__close:hover {
    color: var(--color-pink);
    border-color: var(--color-pink);
  }

  .page-outline__list {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0 1.25rem;
  }

  .page-outline__list a {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .page-outline__list a::before {
    content: '#';
    color: var(--color-comment);
    margin-right: 0.2em;
  }

  .page-outline__list a:hover {
    color: var(--color-text);
  }

  .page-outline__list a.is-active {
    color: var(--color-accent-strong);
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease,
      transform 0.1s ease;
  }

  .button:active {
    transform: scale(0.97);
  }

  .button--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .button:not(.button--primary):hover {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  .section {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .section h2 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
  }

  #about p {
    margin: 0;
    color: var(--color-text-muted);
  }

  #about p:first-of-type {
    color: var(--color-text);
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .section--compact {
    padding-block: 1.5rem;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-bg-alt);
    color: var(--color-string);
    border: 1px solid var(--color-border);
  }

  .section__hint {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.5rem 0 1.75rem;
  }

  .category-pill {
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease,
      transform 0.1s ease;
  }

  .category-pill::before {
    content: '#';
    color: var(--color-comment);
    margin-right: 0.15em;
  }

  .category-pill:hover {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  .category-pill:active {
    transform: scale(0.94);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .filter-bar button {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease,
      transform 0.1s ease;
  }

  .filter-bar button:active {
    transform: scale(0.94);
  }

  .filter-bar button::before {
    content: '#';
    color: var(--color-comment);
    margin-right: 0.15em;
  }

  .filter-bar button:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .filter-bar button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .filter-bar button[aria-pressed='true']::before {
    color: var(--color-on-accent);
  }

  .active-filter {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: -0.75rem 0 1.75rem;
  }

  .active-filter[hidden] {
    display: none;
  }

  .active-filter :global(.active-filter__label) {
    color: var(--color-text-muted);
  }

  .active-filter :global(.active-filter__chip) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--color-pink) 12%, transparent);
    border: 1px solid var(--color-pink);
    color: var(--color-pink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
  }

  .active-filter :global(.active-filter__chip:hover) {
    background: var(--color-pink);
    color: var(--color-on-accent);
  }

