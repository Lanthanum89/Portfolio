---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, categoryOrder } from '../data/projects';

const featured = projects.filter((project) => project.featured);
const more = projects
  .filter((project) => !project.featured)
  .sort((a, b) => new Date(b.pushedAt).getTime() - new Date(a.pushedAt).getTime());
const languages = [...new Set(projects.map((project) => project.language))].sort();

const categories = categoryOrder
  .map((category) => ({
    name: category,
    items: more.filter((project) => project.category === category),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Laura Norwood — Developer"
  description="Developer with a love of data, game design, and making cool things."
>
  <Nav />

  <main id="top">
    <section class="hero wrapper">
      <p class="eyebrow mono hero-in" style="--hero-delay: 0ms">hi, i'm</p>
      <h1 class="mono hero-in" style="--hero-delay: 60ms">
        Laura Norwood<span class="cursor" aria-hidden="true"></span>
      </h1>
      <p class="hero__tagline hero-in" style="--hero-delay: 120ms">
        Developer with a love of data, game design, and making cool things.
      </p>
      <p class="hero__location mono hero-in" style="--hero-delay: 160ms">Reading, England 🇬🇧</p>
      <div class="hero__actions hero-in" style="--hero-delay: 200ms">
        <a class="button button--primary" href="#projects">See my projects</a>
        <a class="button" href="https://github.com/Lanthanum89" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>

    <section id="about" class="wrapper section" data-reveal>
      <p class="eyebrow mono">about</p>
      <h2>A little about me</h2>
      <p>
        I build small, purposeful software — from accessibility-minded games for my kids to
        data-driven analysis tools and everyday utilities. I care about making things that are
        genuinely easy and pleasant to use, whether that's a tap-only interface for tiny fingers
        or a clear dashboard for exploring a dataset.
      </p>
    </section>

    <section id="projects" class="wrapper section" data-reveal>
      <p class="eyebrow mono">projects</p>
      <h2>Featured projects</h2>
      <p class="section__hint">Mirrors the pinned repos on my GitHub profile.</p>

      <div class="grid">
        {featured.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <section id="all-projects" class="wrapper section" data-projects-root>
      <p class="eyebrow mono">all projects</p>
      <h2>Browse by type</h2>
      <p class="section__hint">
        Three most recent per category by default — pick a language to see the full,
        most-recent-first list for it.
      </p>

      <div class="filter-bar mono" data-filter-bar role="group" aria-label="Filter projects by language">
        <button type="button" data-filter="all" aria-pressed="true">all</button>
        {languages.map((language) => (
          <button type="button" data-filter={language} aria-pressed="false">{language.toLowerCase()}</button>
        ))}
      </div>

      {categories.map((group) => (
        <div class="category-group" data-category-group>
          <p class="category-heading mono">// {group.name.toLowerCase()}</p>
          <div class="grid">
            {group.items.map((project, index) => (
              <ProjectCard project={project} rank={index} />
            ))}
          </div>
        </div>
      ))}

      <p class="see-more">
        <a href="https://github.com/Lanthanum89?tab=repositories" target="_blank" rel="noreferrer">
          See everything on GitHub &rarr;
        </a>
      </p>
    </section>

    <section id="contact" class="wrapper section" data-reveal>
      <p class="eyebrow mono">contact</p>
      <h2>Get in touch</h2>
      <p>
        Open to hearing about interesting projects and opportunities. Find me on{' '}
        <a href="https://www.instagram.com/codermumuk/" target="_blank" rel="noreferrer">Instagram</a>,{' '}
        <a href="https://www.linkedin.com/in/laura-norwood/" target="_blank" rel="noreferrer">LinkedIn</a>,{' '}
        or <a href="https://github.com/Lanthanum89" target="_blank" rel="noreferrer">GitHub</a>.
      </p>
    </section>
  </main>

  <Footer />

  <script>
    import { initProjectFilter } from '../scripts/project-filter';
    import { initThemeToggle } from '../scripts/theme-toggle';
    import { initScrollReveal } from '../scripts/scroll-reveal';

    initProjectFilter();
    initThemeToggle();
    initScrollReveal();
  </script>
</Layout>

<style>
  .hero {
    padding-block: 6rem 3rem;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 40rem;
    margin: 0 0 0.5rem;
  }

  .hero__location {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease,
      transform 0.1s ease;
  }

  .button:active {
    transform: scale(0.97);
  }

  .button--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .button:not(.button--primary):hover {
    border-color: var(--color-pink);
    color: var(--color-pink);
  }

  .section {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .section h2 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .section__hint {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .filter-bar button {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease,
      transform 0.1s ease;
  }

  .filter-bar button:active {
    transform: scale(0.94);
  }

  .filter-bar button::before {
    content: '#';
    color: var(--color-comment);
    margin-right: 0.15em;
  }

  .filter-bar button:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .filter-bar button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .filter-bar button[aria-pressed='true']::before {
    color: var(--color-on-accent);
  }

  .category-group {
    margin-bottom: 2rem;
  }

  .category-group.is-empty {
    display: none;
  }

  .category-heading {
    color: var(--color-pink);
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  .see-more {
    margin-top: 2rem;
  }

  .see-more a {
    text-decoration: none;
    font-weight: 600;
    color: var(--color-accent-strong);
    transition: color 0.15s ease;
  }

  .see-more a:hover {
    color: var(--color-pink);
  }

  #contact p {
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  #contact a {
    color: var(--color-accent-strong);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  #contact a:hover {
    color: var(--color-pink);
  }
</style>
