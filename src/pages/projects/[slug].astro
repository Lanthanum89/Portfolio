---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects
    .filter((project) => project.story)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const story = project.story!;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${project.name} | The Story`} description={story.problem}>
  <header class="storynav">
    <a class="storynav__back" href={`${base}#projects`}>&larr; back to portfolio</a>
  </header>

  <main class="story">
    <div class="story__titlebar">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
      <span class="story__filename mono">{project.slug}.{project.ext}</span>
    </div>

    <div class="story__body">
      <p class="story__eyebrow mono">// the story</p>
      <h1>{project.name}</h1>
      <p class="story__description">{project.description}</p>

      <section class="story__section">
        <h2 class="mono">problem</h2>
        <p>{story.problem}</p>
      </section>

      <section class="story__section">
        <h2 class="mono">attempts</h2>
        <ol class="story__attempts">
          {story.attempts.map((attempt, index) => (
            <li>
              <span class="story__attempt-label mono">attempt {index + 1}</span>
              <p>{attempt}</p>
            </li>
          ))}
        </ol>
      </section>

      {story.challenge && (
        <section class="story__section">
          <h2 class="mono">the interesting challenge</h2>
          <p>{story.challenge}</p>
        </section>
      )}

      {story.next && (
        <section class="story__section">
          <h2 class="mono">what's next</h2>
          <p>{story.next}</p>
        </section>
      )}

      <a class="story__cta" href={project.url} target="_blank" rel="noreferrer">
        View the code <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .storynav {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
  }

  .storynav__back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .storynav__back:hover {
    color: var(--color-pink);
  }

  .story {
    max-width: 42rem;
    margin: 2rem auto 6rem;
    padding: 0 1.25rem;
  }

  .story__titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: 0.6rem 0.6rem 0 0;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot--red {
    background: var(--dot-red);
  }

  .dot--yellow {
    background: var(--dot-yellow);
  }

  .dot--green {
    background: var(--dot-green);
  }

  .story__filename {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .story__body {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0 0 0.6rem 0.6rem;
    padding: 1.75rem 1.75rem 2.25rem;
  }

  .story__eyebrow {
    color: var(--color-comment);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .story__body h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  .story__description {
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .story__section {
    margin: 0 0 1.75rem;
  }

  .story__section h2 {
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.03em;
    color: var(--color-pink);
    margin: 0 0 0.6rem;
  }

  .story__section p {
    margin: 0;
    line-height: 1.65;
  }

  .story__attempts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .story__attempts li {
    border-left: 2px solid var(--color-border);
    padding-left: 0.9rem;
  }

  .story__attempt-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-accent-strong);
    margin-bottom: 0.2rem;
  }

  .story__attempts p {
    margin: 0;
    line-height: 1.6;
  }

  .story__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-radius: 0.4rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .story__cta:hover {
    background: var(--color-pink);
  }
</style>
